# Copy to backend/.env and fill in.

# --- Database -----------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string (URI). Use the
# "Session pooler" (port 5432) or direct connection, and the psycopg driver prefix:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave unset to use a local SQLite file (backend/data/bto.db).
DATABASE_URL=

# --- Worker -------------------------------------------------------------------
# true  = run the job worker inside the API process (simplest)
# false = run `python -m app.worker` as a separate process (recommended in production)
EMBEDDED_WORKER=true
WORKER_THREADS=3

# --- LLM fallback (ambiguous matches + missing English translations only) -----
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_CALLS_PER_JOB=500

# --- Crawler ------------------------------------------------------------------
CRAWL_DELAY_SECONDS=1.5
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=2
# CRAWL_USER_AGENT=BreadcrumbTaxonomyOptimizer/1.0 (+internal SEO research; respects robots.txt)

# --- API ----------------------------------------------------------------------
# Optional shared secret; the frontend must send the same value (VITE_API_TOKEN).
API_TOKEN=
CORS_ORIGINS=*
